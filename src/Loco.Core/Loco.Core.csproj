<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Loco.Core</AssemblyName>
    <RootNamespace>Loco.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591;CS1998;CA1416</NoWarn>
    <WarningsAsErrors />
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyTitle>Loco Core - Lightweight Automation</AssemblyTitle>
    <AssemblyDescription>Simple and practical automation engine for everyday tasks.</AssemblyDescription>
    <AssemblyCompany>Loco</AssemblyCompany>
    <AssemblyProduct>Loco</AssemblyProduct>
    <Copyright>Copyright © 2024 Loco Automation</Copyright>
    <AssemblyVersion>0.2.0</AssemblyVersion>
    <FileVersion>0.2.0</FileVersion>
    <PackageVersion>0.2.0-alpha</PackageVersion>
    <InformationalVersion>0.2.0-alpha</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Marketplace\**\*.cs" />
    <Compile Remove="Sharing\**\*.cs" />
    <Compile Remove="Installer\**\*.cs" />
    <Compile Remove="AutoUpdate\**\*.cs" />
    <Compile Remove="Quantum\**\*.cs" />
    <Compile Remove="AI\**\*.cs" />
    <Compile Remove="Internationalization\**\*.cs" />
    <Compile Remove="Performance\**\*.cs" />
    <Compile Remove="Analytics\**\*.cs" />
    <Compile Remove="BPO\**\*.cs" />
    <Compile Remove="Billing\**\*.cs" />
    <Compile Remove="Blockchain\**\*.cs" />
    <Compile Remove="Compliance\**\*.cs" />
    <Compile Remove="Debugging\**\*.cs" />
    <Compile Remove="DigitalTwin\**\*.cs" />
    <Compile Remove="EdgeComputing\**\*.cs" />
    <Compile Remove="Hyperautomation\**\*.cs" />
    <Compile Remove="Interfaces\IOcrService.cs" />
    <Compile Remove="Interfaces\ITranslationService.cs" />
    <Compile Remove="Models\OcrModels.cs" />
    <Compile Remove="Neuromorphic\**\*.cs" />
    <Compile Remove="NoCode\**\*.cs" />
    <Compile Remove="OCR\**\*.cs" />
    <Compile Remove="Orchestration\**\*.cs" />
