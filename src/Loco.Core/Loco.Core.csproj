<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Loco.Core</AssemblyName>
    <RootNamespace>Loco.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591;CS1998;CA1416</NoWarn>
    <WarningsAsErrors />
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyTitle>Loco Core - Lightweight Automation</AssemblyTitle>
    <AssemblyDescription>Simple and practical automation engine for everyday tasks.</AssemblyDescription>
    <AssemblyCompany>Loco</AssemblyCompany>
    <AssemblyProduct>Loco</AssemblyProduct>
    <Copyright>Copyright © 2024 Loco Automation</Copyright>
    <AssemblyVersion>0.2.0</AssemblyVersion>
    <FileVersion>0.2.0</FileVersion>
    <PackageVersion>0.2.0-alpha</PackageVersion>
    <InformationalVersion>0.2.0-alpha</InformationalVersion>

    <!-- Performance Optimizations for .NET 8 -->
    <!-- Dynamic Profile Guided Optimization for improved JIT compilation -->
    <TieredPGO>true</TieredPGO>
    <!-- Enable Ready-to-Run compilation for deployment -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Every package here is one the code actually uses. Eight were removed once
    the namespaces that referenced them were deleted: EntityFrameworkCore and
    its SqlServer and Sqlite providers, Microsoft.Data.Sqlite, System.Management,
    System.ServiceProcess.ServiceController, Microsoft.AspNetCore.Http, and
    System.Diagnostics.DiagnosticSource. Grpc.Tools went with the .proto it
    compiled, which generated server stubs nothing implemented or mapped.

    An unused dependency is not free: it is restored, resolved, audited and
    shipped, and it is the thing most likely to break a build for a reason that
    has nothing to do with the product. Loco stores its data in JSON files - it
    has never opened a database.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
