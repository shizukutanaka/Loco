<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Loco.Core</AssemblyName>
    <RootNamespace>Loco.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591;CS1998;CA1416</NoWarn>
    <WarningsAsErrors />
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyTitle>Loco Core - Lightweight Automation</AssemblyTitle>
    <AssemblyDescription>Simple and practical automation engine for everyday tasks.</AssemblyDescription>
    <AssemblyCompany>Loco</AssemblyCompany>
    <AssemblyProduct>Loco</AssemblyProduct>
    <Copyright>Copyright © 2024 Loco Automation</Copyright>
    <AssemblyVersion>0.2.0</AssemblyVersion>
    <FileVersion>0.2.0</FileVersion>
    <PackageVersion>0.2.0-alpha</PackageVersion>
    <InformationalVersion>0.2.0-alpha</InformationalVersion>

    <!-- Performance Optimizations for .NET 8 -->
    <!-- Dynamic Profile Guided Optimization for improved JIT compilation -->
    <TieredPGO>true</TieredPGO>
    <!-- Enable Ready-to-Run compilation for deployment -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.Storage.SQLite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Dapper for optimized read operations (Phase 2) -->
    <PackageReference Include="Dapper" />
    <!-- gRPC Support -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Grpc\workflow.proto" GrpcServices="Server" />
  </ItemGroup>

  <!-- NOTE: All excluded code has been removed from the repository -->
  <!-- Dead code cleanup completed - see git history for details -->
  <!-- Target: Production-ready codebase without unused/incomplete features -->



</Project>
