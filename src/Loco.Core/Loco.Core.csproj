<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Loco.Core</AssemblyName>
    <RootNamespace>Loco.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591;CS1998;CA1416</NoWarn>
    <WarningsAsErrors />
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyTitle>Loco Core - Lightweight Automation</AssemblyTitle>
    <AssemblyDescription>Simple and practical automation engine for everyday tasks.</AssemblyDescription>
    <AssemblyCompany>Loco</AssemblyCompany>
    <AssemblyProduct>Loco</AssemblyProduct>
    <Copyright>Copyright © 2024 Loco Automation</Copyright>
    <AssemblyVersion>0.2.0</AssemblyVersion>
    <FileVersion>0.2.0</FileVersion>
    <PackageVersion>0.2.0-alpha</PackageVersion>
    <InformationalVersion>0.2.0-alpha</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Marketplace\**\*.cs" />
    <Compile Remove="Sharing\**\*.cs" />
    <Compile Remove="Sync\**\*.cs" />
    <Compile Remove="Installer\**\*.cs" />
    <Compile Remove="AutoUpdate\**\*.cs" />
  </ItemGroup>



</Project>