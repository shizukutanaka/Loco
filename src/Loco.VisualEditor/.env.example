# Visual Editor environment configuration.
# Copy to .env.local for local overrides (Vite loads .env* automatically).
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# API base URL. Leave unset to use the relative "/api/v1", which the Vite dev
# proxy (vite.config.ts) forwards to http://localhost:5000 in development and a
# reverse proxy forwards in production. Set an absolute URL only when the editor
# is served from a different origin than the API.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Realtime collaboration WebSocket server (optional feature). Defaults to
# ws://localhost:3001 in the Collaboration panel when unset.
# VITE_COLLAB_SERVER_URL=ws://localhost:3001
