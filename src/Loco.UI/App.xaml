<Application x:Class="Loco.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Use merged dictionaries for theming; ThemeManager will swap this at runtime. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default to Dark; will be replaced on startup based on user settings. -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <!-- Shared control styles that depend on theme brushes -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>