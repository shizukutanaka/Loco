<Window x:Class="Loco.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Loco.UI"
        xmlns:controls="clr-namespace:Loco.UI.Controls"
        mc:Ignorable="d"
        Title="Loco - AI自動化プラットフォーム (ビジュアルビルダー)" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab Style -->
        <Style x:Key="ModernTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Margin="2,0" Background="Transparent" 
                                BorderBrush="Transparent" BorderThickness="1,1,1,0" 
                                CornerRadius="5,5,0,0">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"
                                            Margin="12,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1">
            <Grid Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🤖" FontSize="32" VerticalAlignment="Center"/>
                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Loco" FontSize="24" FontWeight="Bold" 
                                 Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="Flow Composer - AI自動化プラットフォーム" 
                                 FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" 
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}"
                            Content="🌓 テーマ" Margin="0,0,10,0"
                            Click="ThemeToggle_Click"
                            ToolTip="ライト/ダークテーマを切り替え"/>
                    <Button Style="{StaticResource ModernButton}" 
                          Content="➕ 新規フロー" Margin="0,0,10,0"
                          Click="NewFlow_Click"
                          ToolTip="新しい自動化フローを作成します"/>
                    <Button Style="{StaticResource ModernButton}" 
                          Content="📁 開く" Margin="0,0,10,0"
                          Background="{DynamicResource SuccessBrush}"
                          Click="OpenFlow_Click"
                          ToolTip="既存の自動化フローを開きます"/>
                    <Button Style="{StaticResource ModernButton}" 
                          Content="💾 保存" Margin="0,0,10,0"
                          Background="{DynamicResource WarningBrush}"
                          Click="SaveFlow_Click"
                          ToolTip="現在の自動化フローを保存します"/>
                    <Button Style="{StaticResource ModernButton}" 
                          Content="▶️ 実行" 
                          Click="RunFlow_Click"
                          ToolTip="現在の自動化フローを実行します"/>
                    <Button x:Name="UndoButton" Style="{StaticResource ModernButton}" 
                          Content="↩️ 元に戻す" Margin="10,0,0,0"
                          Click="Undo_Click"
                          ToolTip="最後の操作を元に戻します (Ctrl+Z)"/>
                    <Button x:Name="RedoButton" Style="{StaticResource ModernButton}" 
                          Content="↪️ やり直し" Margin="5,0,0,0"
                          Click="Redo_Click"
                          ToolTip="元に戻した操作をやり直します (Ctrl+Y)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10" Background="Transparent">
            <TabItem Header="🎯 ビジュアルビルダー" Style="{StaticResource ModernTab}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Visual Component Selector -->
                    <Border Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="5" 
                          Margin="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <controls:FlowComposerSelector x:Name="ComponentSelector" />
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="5" 
                                HorizontalAlignment="Stretch" 
                                Background="{DynamicResource BorderBrush}"/>

                    <!-- Flow Preview -->
                    <Border Grid.Column="2" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="5" 
                          Margin="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" 
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="📋 フロープレビュー" 
                                         FontSize="16" FontWeight="Bold" 
                                         Margin="15,10"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FlowPreview" Margin="15">
                                    <!-- Flow components will be added here dynamically -->
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Saved Flows Section -->
                            <Expander x:Name="SavedFlowsExpander" Grid.Row="2" Header="保存済みフロー" Margin="10,5,10,10"
                                      Background="{DynamicResource BackgroundBrush}">
                                <Expander.Resources>
                                    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                                </Expander.Resources>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="検索" Margin="0,0,8,0" VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <TextBox x:Name="SavedFlowsSearchBox" Width="240" 
                                                     TextChanged="SavedFlowsSearchBox_TextChanged"
                                                     ToolTip="フロー名・説明・トリガーで検索"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                <Button Style="{StaticResource ModernButton}" Content="更新" Margin="8,0,0,0" 
                                                        Click="RefreshFlows_Click"/>
                                                <Button Style="{StaticResource ModernButton}" Content="クリア" Margin="8,0,0,0" 
                                                        Click="ClearSearch_Click"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ListView x:Name="SavedFlowsList"
                                                  ItemsSource="{Binding Flows, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Background="{DynamicResource SecondaryBackgroundBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  MouseDoubleClick="SavedFlowsList_MouseDoubleClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource ForegroundBrush}">
                                                                <Run Text="トリガー: "/>
                                                                <Run Text="{Binding TriggerType}"/>
                                                                <Run Text="  |  作成日: "/>
                                                                <Run Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource ModernButton}" Content="✏️ 編集" Margin="4,0,0,0"
                                                                    Click="EditFlow_Click"/>
                                                            <Button Style="{StaticResource ModernButton}" Content="📄 複製" Margin="4,0,0,0"
                                                                    Click="DuplicateFlow_Click"/>
                                                            <Button Style="{StaticResource ModernButton}" Content="🗑️ 削除" Margin="4,0,0,0"
                                                                    Click="DeleteFlow_Click" Background="{DynamicResource ErrorBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Margin="4" FontStyle="Italic" Foreground="{DynamicResource ForegroundBrush}"
                                                   Text="保存済みフローはありません。新規作成するか、既存のフローを読み込んでください。"
                                                   Visibility="{Binding ElementName=SavedFlowsList, Path=Items.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="💬 自然言語" Style="{StaticResource ModernTab}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="自然言語で自動化を作成" 
                             FontSize="18" FontWeight="Bold" 
                             Margin="0,0,0,15"/>

                    <TextBlock Grid.Row="1" Text="例: 毎朝7時にニュースを読み上げて" 
                             FontSize="12" Foreground="{DynamicResource ForegroundBrush}" 
                             Margin="0,0,0,10"/>

                    <TextBox Grid.Row="2" x:Name="NaturalLanguageInput" 
                           TextWrapping="Wrap" AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto"
                           Padding="10" FontSize="14"
                           BorderBrush="{DynamicResource BorderBrush}"
                           ToolTip="自然言語で自動化フローを記述してください (例: 毎朝7時にニュースを読み上げて)"/>

                    <Button Grid.Row="3" Style="{StaticResource ModernButton}"
                          Content="🤖 AIで変換" HorizontalAlignment="Right"
                          Margin="0,15,0,0" Click="ConvertNaturalLanguage_Click"
                          ToolTip="自然言語を自動化フローに変換します"/>
                </Grid>
            </TabItem>

            <TabItem Header="⚙️ 設定" Style="{StaticResource ModernTab}">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="LLMモデル設定" FontSize="18" 
                                 FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <GroupBox Header="モデル選択" Margin="0,0,0,15">
                            <ComboBox x:Name="ModelSelector" Margin="10"
                                    ToolTip="使用するLLMモデルを選択します" />
                        </GroupBox>

                        <TextBlock Text="外観" FontSize="18" 
                                 FontWeight="Bold" Margin="0,10,0,15"/>
                        <GroupBox Header="テーマ" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <ComboBox x:Name="ThemeSelector" Width="200" ToolTip="アプリのテーマを選択します">
                                    <ComboBoxItem Content="ダーク" Tag="Dark" />
                                    <ComboBoxItem Content="ライト" Tag="Light" />
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="実行設定" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="AutoStartCheckBox" Content="起動時に自動的にフローを開始" Margin="0,5"
                                        ToolTip="アプリケーション起動時に自動化フローを開始します"/>
                                <CheckBox x:Name="ErrorNotificationCheckBox" Content="エラー時に通知を表示" IsChecked="True" Margin="0,5"
                                        ToolTip="自動化フロー実行中にエラーが発生した場合に通知を表示します"/>
                                <CheckBox x:Name="DetailedLogsCheckBox" Content="詳細ログを記録" Margin="0,5"
                                        ToolTip="自動化フローの詳細な実行ログを記録します"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="セキュリティ" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="SandboxCheckBox" Content="サンドボックス実行を有効化" IsChecked="True" Margin="0,5"
                                        ToolTip="セキュリティを強化するために自動化フローをサンドボックス環境で実行します"/>
                                <CheckBox x:Name="NetworkRestrictCheckBox" Content="ネットワークアクセスを制限" Margin="0,5"
                                        ToolTip="自動化フローによるネットワークアクセスを制限します"/>
                                <CheckBox x:Name="FileRestrictCheckBox" Content="ファイルアクセスを制限" Margin="0,5"
                                        ToolTip="自動化フローによるファイルアクセスを制限します"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="10,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="状態: " Foreground="{DynamicResource ForegroundBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatusText" Text="準備完了" 
                             Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <TextBlock Text="実行中のフロー: " Foreground="{DynamicResource ForegroundBrush}" FontSize="12"/>
                    <TextBlock x:Name="RunningFlowsCount" Text="0" 
                             Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
