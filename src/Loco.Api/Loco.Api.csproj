<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Performance Optimizations for .NET 8 -->
    <!-- Dynamic Profile Guided Optimization for improved JIT compilation -->
    <TieredPGO>true</TieredPGO>
    <!-- Composite Ready-to-Run images for faster startup -->
    <ReadyToRunComposite>true</ReadyToRunComposite>
    <!-- Enable Ready-to-Run compilation for deployment -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Native AOT (Ahead-of-Time) Compilation for Instant Startup -->
    <!-- Reduces startup time by 85-90% and memory by 30-40% -->
    <!-- Usage: dotnet publish -c Release -r linux-x64 /p:PublishAot=true -->
    <!-- PublishAot enabled selectively (uncomment for production AOT builds) -->
    <!-- <PublishAot>true</PublishAot> -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>

    <!-- Support for different platforms with Native AOT -->
    <!-- Windows x64: -r win-x64 /p:PublishAot=true -->
    <!-- Linux x64:   -r linux-x64 /p:PublishAot=true -->
    <!-- Linux ARM64: -r linux-arm64 /p:PublishAot=true -->
    <!-- macOS x64:   -r osx-x64 /p:PublishAot=true -->
    <!-- macOS ARM64: -r osx-arm64 /p:PublishAot=true -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Dependencies -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />

    <!-- OpenAPI/Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
    <!-- Built-in OpenAPI support; provides RouteHandlerBuilder.WithOpenApi() used by Versioning/ApiVersioningSetup.cs -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />

    <!-- gRPC Support (Phase 1B) -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- API Versioning (maintained Asp.Versioning packages; used by Versioning/ApiVersioningSetup.cs) -->
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" />

    <!-- Rate Limiting -->
    <PackageReference Include="System.Threading.RateLimiting" />

    <!-- JSON Serialization -->
    <PackageReference Include="System.Text.Json" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Enrichers.Context" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loco.Core\Loco.Core.csproj" />
  </ItemGroup>

  <!--
    EXCLUDED FROM COMPILATION — unfinished features whose backing subsystems do not
    exist anywhere in this repository (verified by full-text search of src/):

    - Endpoints\OAuthEndpoints.cs
        Depends on Loco.Core.DataAccess and Loco.Core.Security (namespaces that do not
        exist) and on IOAuthUserRepository / IOAuthClientManager /
        IOAuthAuthorizationCodeManager / IJwtTokenManager, none of which are defined
        in Loco.Core or Loco.Api. There is no OAuth 2.0 server implementation to wire
        these endpoints to.
    - Endpoints\WorkflowEndpoints.cs and Endpoints\MinimalWorkflowEndpoints.cs
        Depend on a "Phase 2/3" data-access layer that was never implemented:
        IWorkflowRepository, IExecutionHistoryRepository and IWorkflowService are not
        defined anywhere, and neither are the Loco.Core.Data / Loco.Core.DataAccess /
        Loco.Core.Execution namespaces they import. The real, tested workflow surface
        is Controllers\WorkflowsController.cs backed by IAutomationEngine + IRuleStore.
    - Controllers\BpmnController.cs
        Depends on Loco.Core.Bpmn (IBpmnWorkflowParser, BpmnWorkflowDefinition), which
        does not exist. Loco.Core has no BPMN parser at all.
    - Controllers\SchedulingController.cs
        Its only dependency, IJobScheduler, has exactly one implementation
        (Loco.Core.Scheduling.HangfireJobScheduler), which requires a Hangfire server
        and storage registration that exists nowhere in the product (no AddHangfire
        call in src/). The controller itself only needs a ProducesResponseType typo
        fix, but it cannot be honestly served until Hangfire hosting is wired.
    - Services\WorkflowEngineGrpcService.cs and Services\WorkflowEngineGrpcClient.cs
        The gRPC surface presupposes an execution-tracking engine API —
        IAutomationEngine.ExecuteAsync / GetExecutionStatusAsync /
        GetExecutionLogsAsync, returning execution ids, progress and log streams.
        The real IAutomationEngine exposes only StartAsync / StopAsync /
        ExecuteFlowAsync(flowId) -> bool and AddFlow; Core has no execution
        store, status store or log store to back the RPCs. Protos\workflow.proto
        (and the divergent copy in Loco.Core\Grpc) remain in the tree as the
        contract draft for whoever builds that engine API first.

    These files are kept in the tree as design drafts. Remove an entry from this list
    only when the missing subsystem it names actually exists and the file compiles
    against real implementations.
  -->
  <ItemGroup>
    <Compile Remove="Endpoints\OAuthEndpoints.cs" />
    <Compile Remove="Endpoints\WorkflowEndpoints.cs" />
    <Compile Remove="Endpoints\MinimalWorkflowEndpoints.cs" />
    <Compile Remove="Controllers\BpmnController.cs" />
    <Compile Remove="Controllers\SchedulingController.cs" />
    <Compile Remove="Services\WorkflowEngineGrpcService.cs" />
    <Compile Remove="Services\WorkflowEngineGrpcClient.cs" />
  </ItemGroup>

</Project>
