<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Central Package Management is enabled repo-wide (Directory.Packages.props),
      so PackageReference entries here must NOT carry Version attributes - the
      previous csproj did, which made even `dotnet restore` fail with NU1008.

      The package set is intentionally minimal: JWT auth, Swagger, and nothing
      else. Rate limiting, health checks, ProblemDetails and JSON all come from
      the ASP.NET Core 8 shared framework. The previous list also pulled gRPC
      (no generated proto types existed - the csproj had no <Protobuf> item),
      Serilog (never wired: Program.cs used AddConsole and never called
      UseSerilog), OpenTelemetry (missing its Hosting package, so AddOpenTelemetry
      didn't even compile), and framework-shipped packages pinned to old versions.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loco.Core\Loco.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WorkflowSchedulerService.ReadSchedule decides whether a workflow is
         scheduled at all, and a wrong answer is silent - the workflow just never
         fires. Exposed to the test project rather than left untestable. -->
    <InternalsVisibleTo Include="Loco.Api.Tests" />
  </ItemGroup>
</Project>
