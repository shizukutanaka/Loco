<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Central Package Management is enabled repo-wide (Directory.Packages.props),
      so PackageReference entries here must NOT carry Version attributes - the
      previous csproj did, which made even `dotnet restore` fail with NU1008.

      The package set is intentionally minimal: JWT auth, Swagger, and nothing
      else. Rate limiting, health checks, ProblemDetails and JSON all come from
      the ASP.NET Core 8 shared framework. The previous list also pulled gRPC
      (no generated proto types existed - the csproj had no <Protobuf> item),
      Serilog (never wired: Program.cs used AddConsole and never called
      UseSerilog), OpenTelemetry (missing its Hosting package, so AddOpenTelemetry
      didn't even compile), and framework-shipped packages pinned to old versions.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loco.Core\Loco.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Excluded-from-build inventory. These files reference namespaces/types
      deleted in the bb7147f cleanup (Loco.Core.DataAccess, .Execution, .Health,
      .Bpmn, .ErrorHandling, generated gRPC types), depend on packages this
      project no longer takes (Serilog, Grpc), or are unwired "pattern gallery"
      sample code with no callers. SchedulingController has a typo'd attribute
      ([ProduceResponseType]) and has never compiled. They are excluded rather
      than deleted so reviewers can inspect and delete them deliberately;
      none of them are part of the shipped API surface.
    -->
  </ItemGroup>

</Project>
