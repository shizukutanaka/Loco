<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Performance Optimizations for .NET 8 -->
    <!-- Dynamic Profile Guided Optimization for improved JIT compilation -->
    <TieredPGO>true</TieredPGO>
    <!-- Composite Ready-to-Run images for faster startup -->
    <ReadyToRunComposite>true</ReadyToRunComposite>
    <!-- Enable Ready-to-Run compilation for deployment -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Native AOT (Ahead-of-Time) Compilation for Instant Startup -->
    <!-- Reduces startup time by 85-90% and memory by 30-40% -->
    <!-- Usage: dotnet publish -c Release -r linux-x64 /p:PublishAot=true -->
    <!-- PublishAot enabled selectively (uncomment for production AOT builds) -->
    <!-- <PublishAot>true</PublishAot> -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>

    <!-- Support for different platforms with Native AOT -->
    <!-- Windows x64: -r win-x64 /p:PublishAot=true -->
    <!-- Linux x64:   -r linux-x64 /p:PublishAot=true -->
    <!-- Linux ARM64: -r linux-arm64 /p:PublishAot=true -->
    <!-- macOS x64:   -r osx-x64 /p:PublishAot=true -->
    <!-- macOS ARM64: -r osx-arm64 /p:PublishAot=true -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Dependencies -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.0.0" />

    <!-- OpenAPI/Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.4.0" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0" />

    <!-- Rate Limiting -->
    <PackageReference Include="Microsoft.AspNetCore.RateLimiting" Version="8.0.0" />
    <PackageReference Include="System.Threading.RateLimiting" Version="8.0.0" />

    <!-- JSON Serialization -->
    <PackageReference Include="System.Text.Json" Version="8.0.0" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageReference Include="Serilog.Enrichers.Context" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loco.Core\Loco.Core.csproj" />
  </ItemGroup>

</Project>
