{
  "id": "backup-workflow",
  "name": "Automated Backup Workflow",
  "description": "Automated backup workflow with logging and notifications",
  "steps": [
    {
      "id": "step1",
      "name": "Initialize backup",
      "type": "log",
      "message": "Initializing backup process..."
    },
    {
      "id": "step2",
      "name": "Verify source",
      "type": "file",
      "message": "Verifying source files exist",
      "path": "."
    },
    {
      "id": "step3",
      "name": "Prepare backup",
      "type": "log",
      "message": "Preparing backup destination..."
    },
    {
      "id": "step4",
      "name": "Perform backup",
      "type": "backup",
      "message": "Performing backup operation",
      "source": "./data",
      "destination": "./backup/data"
    },
    {
      "id": "step5",
      "name": "Wait for completion",
      "type": "delay",
      "duration": "00:00:02"
    },
    {
      "id": "step6",
      "name": "Verify backup",
      "type": "file",
      "message": "Verifying backup completed",
      "path": "./backup"
    },
    {
      "id": "step7",
      "name": "Complete",
      "type": "log",
      "message": "Backup workflow completed successfully!"
    }
  ]
}
