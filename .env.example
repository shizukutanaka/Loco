# Loco .env example / Loco 用 .env サンプル
#
# EN: Copy this file to ".env" and fill in values as needed.
#     Do NOT commit your real credentials to source control.
#     Hosts load .env at startup (searching from AppContext.BaseDirectory upward) and
#     will NOT override variables already set in the OS environment.
# JA: このファイルを「.env」にコピーして必要な値を設定してください。
#     実際の認証情報はリポジトリにコミットしないでください。
#     ホストは起動時に .env を読み込みます（AppContext.BaseDirectory から上位へ検索）。
#     既に OS の環境変数で設定されている値は上書きしません。

########################################
# Common LLM settings / 共通 LLM 設定
########################################
# Optional preset (OPENAI|OLLAMA|OPENROUTER). Primes defaults without overriding
# explicit values. / 任意のプリセット（既定値を補完、明示設定は上書きしません）
#LOCO_LLM__PRESET=OPENAI

# Provider-agnostic / プロバイダー共通
#LOCO_LLM__PROVIDER=
#LOCO_LLM__MODEL=
#LOCO_LLM__APIKEY=
#LOCO_LLM__APIENDPOINT=
#LOCO_LLM__TEMPERATURE=0.2
#LOCO_LLM__MAXTOKENS=1024
# HTTP timeout in ms (default 30000; clamped 1000–600000)
# HTTP タイムアウト（既定 30000、範囲 1000–600000 にクランプ）
#LOCO_LLM__HTTPTIMEOUTMS=45000

########################################
# OPENAI preset example / OPENAI プリセット例
########################################
#LOCO_LLM__PRESET=OPENAI
#LOCO_LLM__PROVIDER=openai
#OPENAI_API_KEY=sk-...
# Optional custom endpoint / 任意のカスタムエンドポイント
#OPENAI_BASE_URL=https://api.openai.com/v1
#LOCO_LLM__MODEL=gpt-4o-mini

########################################
# OLLAMA preset example / OLLAMA プリセット例
########################################
#LOCO_LLM__PRESET=OLLAMA
#LOCO_LLM__PROVIDER=ollama
#OLLAMA_BASE_URL=http://localhost:11434
#LOCO_LLM__MODEL=llama3:8b

########################################
# OPENROUTER preset example / OPENROUTER プリセット例
########################################
#LOCO_LLM__PRESET=OPENROUTER
#LOCO_LLM__PROVIDER=openrouter
#LOCO_LLM__APIKEY=or-...
#LOCO_LLM__APIENDPOINT=https://openrouter.ai/api/v1/chat/completions
#LOCO_LLM__MODEL=openrouter/auto

########################################
# Provider-specific fallbacks / プロバイダー別フォールバック
########################################
# These are read if LOCO_LLM__* are not set. / LOCO_LLM__* が未設定の場合に参照されます。
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=
#GEMINI_API_KEY=
#GOOGLE_API_KEY=
#GEMINI_BASE_URL=
#OLLAMA_BASE_URL=

########################################
# Plugins path (CLI/UI) / プラグインパス（CLI/UI）
########################################
#LOCO_PLUGINS_PATH=%APPDATA%/Loco/Plugins

########################################
# Quick verification / すぐ確認するには
########################################
# EN: Run `loco llm config` to print effective LLM configuration (API key redacted).
#     Output includes HasApiKey and Preset (from LOCO_LLM__PRESET) and matches /api/llm/config.
# JA: `loco llm config` を実行すると有効な LLM 設定を表示します（APIキーはマスク）。
#     出力には HasApiKey と Preset（LOCO_LLM__PRESET）が含まれ、/api/llm/config と一致します。
