[
  {
    "input": "毎朝7時にニュースを読み上げて",
    "expectedRule": {
      "trigger": {
        "type": "time",
        "parameters": {
          "hour": 7,
          "minute": 0
        }
      },
      "actions": [
        {
          "type": "httpRequest",
          "parameters": {
            "url": "https://newsapi.org/v2/top-headlines"
          }
        },
        {
          "type": "tts",
          "parameters": {
            "text": "${responseBody}"
          }
        }
      ]
    }
  },
  {
    "input": "バッテリーが20%以下になったら通知して",
    "expectedRule": {
      "trigger": {
        "type": "systemEvent",
        "parameters": {
          "eventType": "BatteryLevel",
          "threshold": 20
        }
      },
      "actions": [
        {
          "type": "notification",
          "parameters": {
            "title": "バッテリー低下",
            "message": "バッテリー残量が20%以下です"
          }
        }
      ]
    }
  },
  {
    "input": "ChromeがスタートしたらSlackも起動",
    "expectedRule": {
      "trigger": {
        "type": "application",
        "parameters": {
          "processName": "chrome"
        }
      },
      "actions": [
        {
          "type": "launchApp",
          "parameters": {
            "appName": "slack"
          }
        }
      ]
    }
  },
  {
    "input": "毎日18時にDocumentsフォルダをバックアップ",
    "expectedRule": {
      "trigger": {
        "type": "time",
        "parameters": {
          "hour": 18,
          "minute": 0
        }
      },
      "actions": [
        {
          "type": "file",
          "parameters": {
            "operation": "copy",
            "path": "%USERPROFILE%\\Documents",
            "destination": "D:\\Backup\\Documents_%DATE%"
          }
        }
      ]
    }
  },
  {
    "input": "5分ごとにCPU使用率をチェックして、80%超えたらアラート",
    "expectedRule": {
      "trigger": {
        "type": "interval",
        "parameters": {
          "intervalMs": 300000
        }
      },
      "conditions": [
        {
          "type": "systemMetric",
          "parameters": {
            "metric": "cpuUsage",
            "threshold": 80
          }
        }
      ],
      "actions": [
        {
          "type": "notification",
          "parameters": {
            "title": "CPU使用率警告",
            "message": "CPU使用率が80%を超えています",
            "priority": "high"
          }
        }
      ]
    }
  },
  {
    "input": "新しいメールが来たらAIで要約して通知",
    "expectedRule": {
      "trigger": {
        "type": "email",
        "parameters": {
          "event": "new"
        }
      },
      "actions": [
        {
          "type": "llmQuery",
          "parameters": {
            "prompt": "このメールを日本語で簡潔に要約してください: ${emailContent}",
            "modelId": "local-japanese"
          }
        },
        {
          "type": "notification",
          "parameters": {
            "title": "新着メール: ${emailSubject}",
            "message": "${llmResponse}"
          }
        }
      ]
    }
  },
  {
    "input": "PDFファイルがダウンロードされたら自動で印刷",
    "expectedRule": {
      "trigger": {
        "type": "fileSystem",
        "parameters": {
          "path": "%USERPROFILE%\\Downloads",
          "filter": "*.pdf"
        }
      },
      "actions": [
        {
          "type": "shell",
          "parameters": {
            "command": "print",
            "arguments": "${triggerContext.fullPath}"
          }
        }
      ]
    }
  },
  {
    "input": "夜10時になったらPCをスリープモードに",
    "expectedRule": {
      "trigger": {
        "type": "time",
        "parameters": {
          "hour": 22,
          "minute": 0
        }
      },
      "actions": [
        {
          "type": "shell",
          "parameters": {
            "command": "rundll32.exe",
            "arguments": "powrprof.dll,SetSuspendState 0,1,0"
          }
        }
      ]
    }
  },
  {
    "input": "Zoomミーティングの5分前に通知",
    "expectedRule": {
      "trigger": {
        "type": "calendar",
        "parameters": {
          "eventType": "meeting",
          "keyword": "zoom",
          "minutesBefore": 5
        }
      },
      "actions": [
        {
          "type": "notification",
          "parameters": {
            "title": "Zoomミーティング開始",
            "message": "5分後にZoomミーティングが始まります",
            "priority": "high"
          }
        },
        {
          "type": "tts",
          "parameters": {
            "text": "Zoomミーティングが5分後に始まります"
          }
        }
      ]
    }
  },
  {
    "input": "スクリーンショットを撮ったら自動でクラウドにアップロード",
    "expectedRule": {
      "trigger": {
        "type": "fileSystem",
        "parameters": {
          "path": "%USERPROFILE%\\Pictures\\Screenshots",
          "filter": "*.png",
          "events": ["created"]
        }
      },
      "actions": [
        {
          "type": "httpRequest",
          "parameters": {
            "method": "POST",
            "url": "https://api.cloudservice.com/upload",
            "body": "${fileContent}"
          }
        },
        {
          "type": "notification",
          "parameters": {
            "title": "スクリーンショット アップロード完了",
            "message": "${triggerContext.name} をクラウドにアップロードしました"
          }
        }
      ]
    }
  }
]