{
  "id": "daily-backup",
  "name": "Daily Documents Backup",
  "description": "Backup Documents folder daily at 6 PM",
  "triggers": [
    {
      "type": "Schedule",
      "time": "18:00:00",
      "days": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
    }
  ],
  "conditions": [
    {
      "type": "FolderExists",
      "path": "%USERPROFILE%\\Documents"
    }
  ],
  "actions": [
    {
      "type": "Backup",
      "source": "%USERPROFILE%\\Documents",
      "destination": "D:\\Backups\\Documents",
      "compression": true,
      "includeTimestamp": true,
      "retentionDays": 30
    },
    {
      "type": "Notification",
      "title": "Backup Complete",
      "message": "Documents backup completed successfully"
    }
  ]
}