{
  "id": "llm-news-summary",
  "name": "AI News Summary",
  "description": "Fetch news and create AI summary every morning",
  "trigger": {
    "type": "time",
    "parameters": {
      "hour": 7,
      "minute": 0
    }
  },
  "conditions": [],
  "actions": [
    {
      "type": "httpRequest",
      "parameters": {
        "url": "https://api.example.com/news/latest",
        "method": "GET"
      }
    },
    {
      "type": "llmQuery",
      "parameters": {
        "prompt": "Summarize the following news in Japanese: ${responseBody}",
        "modelId": "local-model-1",
        "maxTokens": 500
      }
    },
    {
      "type": "tts",
      "parameters": {
        "text": "${llmResponse}",
        "voice": "Japanese",
        "rate": 0
      }
    },
    {
      "type": "notification",
      "parameters": {
        "title": "Morning News Summary",
        "message": "${llmResponse}",
        "priority": "normal"
      }
    }
  ],
  "permissions": {
    "network": true,
    "llm": true,
    "notification": true,
    "allowedDomains": ["api.example.com"]
  }
}