{
  "name": "Tasker風 朝のルーティン",
  "description": "Tasker風UIで作成した朝の自動化フロー",
  "id": "tasker-morning-routine",
  "enabled": true,
  "components": [
    {
      "id": "trigger-1",
      "componentId": "time.schedule",
      "type": "Trigger",
      "parameters": {
        "hour": 7,
        "minute": 0,
        "weekdays": ["月", "火", "水", "木", "金"]
      }
    },
    {
      "id": "condition-1",
      "componentId": "network.ping",
      "type": "Condition",
      "parameters": {
        "host": "google.com",
        "timeout": 5
      }
    },
    {
      "id": "action-1",
      "componentId": "http.request",
      "type": "Action",
      "parameters": {
        "url": "https://api.weather.com/today",
        "method": "GET"
      }
    },
    {
      "id": "action-2",
      "componentId": "llm.summarize",
      "type": "Action",
      "parameters": {
        "text": "${httpResponse}",
        "length": "短い"
      }
    },
    {
      "id": "action-3",
      "componentId": "tts.speak",
      "type": "Action",
      "parameters": {
        "text": "おはようございます。今日の天気は${llmSummary}です。",
        "voice": "女性",
        "speed": 1.0
      }
    },
    {
      "id": "action-4",
      "componentId": "notification.show",
      "type": "Action",
      "parameters": {
        "title": "朝のお知らせ",
        "message": "今日も一日頑張りましょう！",
        "icon": "info"
      }
    }
  ],
  "variables": {
    "httpResponse": "",
    "llmSummary": ""
  },
  "settings": {
    "maxRetries": 3,
    "timeout": 30,
    "logLevel": "info"
  }
}
