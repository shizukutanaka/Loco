{
  "id": "plugin-test-rule",
  "name": "Plugin Test Rule",
  "description": "A simple rule to test a plugin action.",
  "enabled": true,
  "trigger": {
    "type": "manual"
  },
  "actions": [
    {
      "id": "log-action",
      "type": "log-to-file",
      "name": "Log to plugin-test.log",
      "parameters": {
        "Message": "Plugin action executed successfully!",
        "FileName": "plugin-test.log"
      }
    }
  ]
}
