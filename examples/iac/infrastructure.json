{
  "version": "1.0",
  "variables": {
    "environment": "production",
    "region": "us-east-1",
    "appVersion": "1.0.0"
  },
  "workflows": [
    {
      "name": "deploy-application",
      "description": "Deploy application to production",
      "schedule": "0 2 * * *",
      "environment": {
        "APP_ENV": "production",
        "LOG_LEVEL": "info"
      },
      "retry": {
        "maxRetries": 3,
        "initialDelayMs": 5000,
        "strategy": "exponential"
      },
      "steps": [
        {
          "type": "shell",
          "name": "run-tests",
          "config": {
            "command": "dotnet test",
            "workingDirectory": "/app",
            "timeoutSeconds": 300
          },
          "retry": {
            "maxRetries": 2,
            "initialDelayMs": 1000,
            "strategy": "linear"
          }
        },
        {
          "type": "shell",
          "name": "build-application",
          "config": {
            "command": "dotnet build -c Release",
            "workingDirectory": "/app"
          }
        },
        {
          "type": "shell",
          "name": "deploy-to-server",
          "config": {
            "command": "./deploy.sh",
            "workingDirectory": "/app/scripts"
          },
          "if": "{{variables.environment}} == 'production'"
        }
      ]
    },
    {
      "name": "database-backup",
      "description": "Backup database daily",
      "schedule": "0 1 * * *",
      "steps": [
        {
          "type": "shell",
          "name": "backup-database",
          "config": {
            "command": "pg_dump -U postgres mydb > backup.sql",
            "timeoutSeconds": 1800
          }
        },
        {
          "type": "shell",
          "name": "upload-to-storage",
          "config": {
            "command": "aws s3 cp backup.sql s3://my-backups/"
          }
        }
      ]
    },
    {
      "name": "health-check",
      "description": "System health check",
      "schedule": "*/15 * * * *",
      "steps": [
        {
          "type": "http",
          "name": "check-api",
          "config": {
            "url": "https://api.example.com/health",
            "method": "GET",
            "expectedStatus": 200,
            "timeoutSeconds": 30
          }
        },
        {
          "type": "shell",
          "name": "check-disk-space",
          "config": {
            "command": "df -h"
          }
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "DATABASE_URL",
      "source": "env:DATABASE_URL",
      "description": "PostgreSQL connection string"
    },
    {
      "name": "API_KEY",
      "source": "env:API_KEY",
      "description": "External API key"
    },
    {
      "name": "AWS_ACCESS_KEY",
      "source": "file:/etc/secrets/aws-access-key",
      "description": "AWS access key for S3"
    }
  ],
  "monitoring": {
    "enabled": true,
    "healthCheck": {
      "intervalSeconds": 60,
      "endpoint": "http://localhost:8080/health"
    },
    "alerts": [
      {
        "type": "email",
        "condition": "failure_rate > 0.1",
        "config": {
          "recipients": [
            "ops@example.com"
          ],
          "subject": "Loco Alert: High Failure Rate"
        }
      },
      {
        "type": "webhook",
        "condition": "response_time > 5000",
        "config": {
          "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
          "method": "POST"
        }
      }
    ]
  }
}
