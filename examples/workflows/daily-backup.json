{
  "name": "daily-backup",
  "description": "Daily backup and cleanup automation",
  "version": "1.0.0",
  "steps": [
    {
      "name": "backup-config",
      "type": "backup",
      "description": "Backup configuration files",
      "parameters": {
        "source": "config",
        "label": "Daily automated backup"
      }
    },
    {
      "name": "cleanup-temp",
      "type": "cleanup",
      "description": "Clean temporary files",
      "parameters": {
        "path": "${TEMP}",
        "patterns": ["*.tmp", "*.cache", "*.bak"],
        "olderThanDays": 7
      }
    },
    {
      "name": "cleanup-logs",
      "type": "cleanup",
      "description": "Clean old log files",
      "parameters": {
        "path": "logs",
        "patterns": ["*.log"],
        "olderThanDays": 30
      }
    },
    {
      "name": "verify-backup",
      "type": "verify",
      "description": "Verify backup completed successfully",
      "parameters": {
        "checksum": true
      }
    },
    {
      "name": "log-completion",
      "type": "log",
      "description": "Log completion status",
      "parameters": {
        "message": "Daily backup and cleanup completed",
        "level": "info"
      }
    }
  ],
  "schedule": {
    "cron": "0 2 * * *",
    "timezone": "UTC",
    "enabled": true
  },
  "retryPolicy": {
    "maxAttempts": 3,
    "backoffMultiplier": 2,
    "initialDelaySeconds": 60
  },
  "notifications": {
    "onFailure": true,
    "onSuccess": true,
    "channels": ["email", "log"]
  }
}
