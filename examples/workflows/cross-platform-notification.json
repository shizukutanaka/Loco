{
  "version": "1.0",
  "id": "cross-platform-notification-001",
  "name": "Daily Reminder",
  "description": "Cross-platform daily reminder that works on all platforms",
  "platforms": ["android", "ios", "windows", "mac", "linux"],
  "enabled": true,
  "triggers": [
    {
      "type": "time",
      "parameters": {
        "schedule": "0 12 * * *",
        "description": "Every day at noon"
      },
      "description": "Daily reminder at 12:00 PM"
    }
  ],
  "constraints": [],
  "actions": [
    {
      "id": "action-http-check",
      "type": "http_request",
      "parameters": {
        "method": "GET",
        "url": "https://api.example.com/tasks/today",
        "headers": {
          "Authorization": "Bearer ${API_TOKEN}"
        },
        "timeout": 10000
      },
      "description": "Fetch today's tasks from API",
      "retry": {
        "maxAttempts": 3,
        "delayMs": 2000,
        "backoffStrategy": "exponential"
      },
      "onError": {
        "strategy": "fallback",
        "fallbackAction": {
          "id": "action-default-message",
          "type": "notification",
          "parameters": {
            "title": "Daily Reminder",
            "message": "Don't forget to check your tasks!",
            "priority": "default"
          }
        }
      }
    },
    {
      "id": "action-notify",
      "type": "notification",
      "parameters": {
        "title": "Tasks for Today",
        "message": "${response.taskCount} tasks remaining",
        "priority": "high"
      },
      "description": "Show notification with task count"
    }
  ],
  "metadata": {
    "author": "Loco Team",
    "category": "productivity",
    "tags": ["reminder", "tasks", "cross-platform"],
    "note": "Uses only actions supported on all platforms"
  },
  "createdAt": "2025-10-24T00:00:00Z",
  "updatedAt": "2025-10-24T00:00:00Z"
}
