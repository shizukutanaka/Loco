{
  "name": "log-cleanup",
  "description": "Clean up old log files and optimize storage",
  "version": "1.0",
  "steps": [
    {
      "id": "check-log-size",
      "name": "Check Log Directory Size",
      "type": "monitor",
      "action": "disk",
      "parameters": {
        "path": "logs",
        "threshold": "100MB"
      }
    },
    {
      "id": "list-old-logs",
      "name": "List Old Log Files",
      "type": "file",
      "action": "search",
      "parameters": {
        "directory": "logs",
        "pattern": "*.log",
        "olderThan": "30d"
      },
      "dependsOn": ["check-log-size"]
    },
    {
      "id": "archive-logs",
      "name": "Archive Old Logs",
      "type": "file",
      "action": "compress",
      "parameters": {
        "source": "logs/*.log",
        "destination": "logs/archive",
        "format": "zip",
        "olderThan": "30d"
      },
      "dependsOn": ["list-old-logs"]
    },
    {
      "id": "delete-old-logs",
      "name": "Delete Archived Logs",
      "type": "file",
      "action": "delete",
      "parameters": {
        "pattern": "logs/*.log",
        "olderThan": "30d",
        "confirm": false
      },
      "dependsOn": ["archive-logs"]
    },
    {
      "id": "verify-cleanup",
      "name": "Verify Cleanup Completed",
      "type": "monitor",
      "action": "disk",
      "parameters": {
        "path": "logs",
        "threshold": "100MB"
      },
      "dependsOn": ["delete-old-logs"]
    },
    {
      "id": "send-report",
      "name": "Send Cleanup Report",
      "type": "log",
      "action": "info",
      "parameters": {
        "message": "Log cleanup completed successfully"
      },
      "dependsOn": ["verify-cleanup"]
    }
  ],
  "schedule": {
    "type": "cron",
    "expression": "0 3 * * 0",
    "timezone": "Local"
  },
  "options": {
    "maxParallelism": 1,
    "timeout": 3600,
    "retryCount": 2,
    "continueOnError": false
  },
  "metadata": {
    "author": "Loco Team",
    "tags": ["maintenance", "cleanup", "logs"],
    "category": "Maintenance"
  }
}
