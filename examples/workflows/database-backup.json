{
  "name": "database-backup",
  "description": "Automated database backup with verification and cloud upload",
  "version": "1.0",
  "steps": [
    {
      "id": "pre-backup-check",
      "name": "Pre-Backup System Check",
      "type": "monitor",
      "action": "system",
      "parameters": {
        "checkDisk": true,
        "checkMemory": true,
        "minDiskSpace": "5GB"
      }
    },
    {
      "id": "create-backup-dir",
      "name": "Create Backup Directory",
      "type": "file",
      "action": "mkdir",
      "parameters": {
        "path": "backups/database",
        "createParents": true
      },
      "dependsOn": ["pre-backup-check"]
    },
    {
      "id": "dump-database",
      "name": "Dump Database",
      "type": "process",
      "action": "execute",
      "parameters": {
        "command": "pg_dump",
        "args": ["-h", "localhost", "-U", "dbuser", "-d", "mydb", "-f", "backups/database/db-{{timestamp}}.sql"],
        "timeout": 600
      },
      "dependsOn": ["create-backup-dir"]
    },
    {
      "id": "compress-backup",
      "name": "Compress Backup File",
      "type": "file",
      "action": "compress",
      "parameters": {
        "source": "backups/database/db-*.sql",
        "format": "gzip",
        "deleteSource": true
      },
      "dependsOn": ["dump-database"]
    },
    {
      "id": "verify-backup",
      "name": "Verify Backup Integrity",
      "type": "file",
      "action": "checksum",
      "parameters": {
        "file": "backups/database/db-*.sql.gz",
        "algorithm": "sha256"
      },
      "dependsOn": ["compress-backup"]
    },
    {
      "id": "upload-to-cloud",
      "name": "Upload to Cloud Storage",
      "type": "network",
      "action": "upload",
      "parameters": {
        "source": "backups/database/db-*.sql.gz",
        "destination": "s3://my-backups/database/",
        "deleteLocal": false
      },
      "dependsOn": ["verify-backup"]
    },
    {
      "id": "cleanup-old-backups",
      "name": "Cleanup Old Local Backups",
      "type": "file",
      "action": "delete",
      "parameters": {
        "pattern": "backups/database/db-*.sql.gz",
        "olderThan": "7d",
        "keepMinimum": 3
      },
      "dependsOn": ["upload-to-cloud"]
    },
    {
      "id": "send-notification",
      "name": "Send Success Notification",
      "type": "log",
      "action": "info",
      "parameters": {
        "message": "Database backup completed and uploaded successfully"
      },
      "dependsOn": ["cleanup-old-backups"]
    }
  ],
  "schedule": {
    "type": "cron",
    "expression": "0 2 * * *",
    "timezone": "UTC"
  },
  "options": {
    "maxParallelism": 1,
    "timeout": 7200,
    "retryCount": 3,
    "continueOnError": false
  },
  "errorHandling": {
    "onError": "send-alert",
    "rollback": true
  },
  "metadata": {
    "author": "Loco Team",
    "tags": ["database", "backup", "cloud"],
    "category": "Backup",
    "priority": "high"
  }
}
