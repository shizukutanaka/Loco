{
  "id": "web-service-monitoring",
  "name": "Web Service Health Monitoring",
  "description": "Monitor multiple web services and APIs for availability and performance",
  "version": "1.0",
  "author": "Loco Team",
  "tags": ["monitoring", "web", "api", "health"],
  
  "variables": {
    "primaryUrl": "https://api.example.com",
    "secondaryUrl": "https://backup-api.example.com",
    "healthEndpoint": "/health",
    "metricsEndpoint": "/metrics",
    "alertEmail": "devops@example.com",
    "responseTimeThreshold": "2000",
    "checkInterval": "60"
  },
  
  "schedule": {
    "type": "interval",
    "intervalSeconds": 60,
    "description": "Run every minute"
  },
  
  "steps": [
    {
      "id": "check-primary-health",
      "name": "Check Primary Service Health",
      "type": "http",
      "action": "get",
      "parameters": {
        "url": "${primaryUrl}${healthEndpoint}",
        "timeout": "5000",
        "expectedStatus": "200",
        "saveResponse": "true",
        "outputVariable": "primaryHealth"
      },
      "retry": {
        "maxAttempts": 3,
        "delay": "00:00:05",
        "backoffMultiplier": 2
      },
      "description": "Verify primary service is responding"
    },
    {
      "id": "measure-primary-latency",
      "name": "Measure Primary Service Latency",
      "type": "http",
      "action": "get",
      "parameters": {
        "url": "${primaryUrl}${metricsEndpoint}",
        "timeout": "10000",
        "measureResponseTime": "true",
        "outputVariable": "primaryLatency"
      },
      "continueOnError": true,
      "description": "Measure API response time"
    },
    {
      "id": "check-latency-threshold",
      "name": "Check if Latency Exceeds Threshold",
      "type": "condition",
      "action": "evaluate",
      "parameters": {
        "condition": "${primaryLatency.responseTime} > ${responseTimeThreshold}",
        "outputVariable": "highLatency"
      },
      "description": "Determine if latency is above acceptable threshold"
    },
    {
      "id": "alert-high-latency",
      "name": "Alert High Latency",
      "type": "notification",
      "action": "email",
      "parameters": {
        "to": "${alertEmail}",
        "subject": "High Latency Alert - ${primaryUrl}",
        "body": "Service latency (${primaryLatency.responseTime}ms) exceeds threshold (${responseTimeThreshold}ms)",
        "priority": "high"
      },
      "runIf": "${highLatency}",
      "continueOnError": true,
      "description": "Send alert if latency is too high"
    },
    {
      "id": "check-secondary-health",
      "name": "Check Secondary Service Health",
      "type": "http",
      "action": "get",
      "parameters": {
        "url": "${secondaryUrl}${healthEndpoint}",
        "timeout": "5000",
        "expectedStatus": "200",
        "saveResponse": "true",
        "outputVariable": "secondaryHealth"
      },
      "continueOnError": true,
      "description": "Verify backup service is responding"
    },
    {
      "id": "check-database-connection",
      "name": "Verify Database Connectivity",
      "type": "database",
      "action": "ping",
      "parameters": {
        "connectionString": "${env:DB_CONNECTION_STRING}",
        "timeout": "5000"
      },
      "continueOnError": true,
      "description": "Ensure database is accessible"
    },
    {
      "id": "check-redis-cache",
      "name": "Verify Redis Cache",
      "type": "cache",
      "action": "ping",
      "parameters": {
        "host": "${env:REDIS_HOST}",
        "port": "6379",
        "timeout": "3000"
      },
      "continueOnError": true,
      "description": "Ensure cache server is responding"
    },
    {
      "id": "aggregate-metrics",
      "name": "Aggregate Health Metrics",
      "type": "data",
      "action": "aggregate",
      "parameters": {
        "sources": [
          "${primaryHealth}",
          "${secondaryHealth}",
          "${primaryLatency}"
        ],
        "outputFile": "metrics/health-${date:yyyy-MM-dd-HH-mm}.json"
      },
      "description": "Combine all health check results"
    },
    {
      "id": "update-dashboard",
      "name": "Update Monitoring Dashboard",
      "type": "integration",
      "action": "update-dashboard",
      "parameters": {
        "dashboardId": "main-health",
        "metrics": "${aggregatedMetrics}",
        "timestamp": "${date:yyyy-MM-dd HH:mm:ss}"
      },
      "continueOnError": true,
      "description": "Push metrics to visualization dashboard"
    },
    {
      "id": "check-ssl-certificate",
      "name": "Verify SSL Certificate Validity",
      "type": "security",
      "action": "check-certificate",
      "parameters": {
        "url": "${primaryUrl}",
        "warningDays": "30",
        "outputVariable": "sslStatus"
      },
      "continueOnError": true,
      "description": "Ensure SSL certificate is valid and not expiring soon"
    },
    {
      "id": "alert-ssl-expiring",
      "name": "Alert SSL Certificate Expiring",
      "type": "notification",
      "action": "email",
      "parameters": {
        "to": "${alertEmail}",
        "subject": "SSL Certificate Expiring Soon - ${primaryUrl}",
        "body": "SSL certificate expires in ${sslStatus.daysUntilExpiry} days",
        "priority": "medium"
      },
      "runIf": "${sslStatus.expiringWithinWarningPeriod}",
      "continueOnError": true,
      "description": "Alert if SSL certificate needs renewal"
    }
  ],
  
  "onError": {
    "steps": [
      {
        "id": "primary-down-alert",
        "name": "Send Service Down Alert",
        "type": "notification",
        "action": "multi-channel",
        "parameters": {
          "channels": ["email", "slack", "sms"],
          "email": "${alertEmail}",
          "slackWebhook": "${env:SLACK_WEBHOOK_URL}",
          "message": "CRITICAL: Primary service ${primaryUrl} is DOWN!",
          "priority": "critical"
        }
      },
      {
        "id": "failover-check",
        "name": "Check Failover Readiness",
        "type": "condition",
        "action": "evaluate",
        "parameters": {
          "condition": "${secondaryHealth.success} == true",
          "outputVariable": "canFailover"
        }
      },
      {
        "id": "initiate-failover",
        "name": "Initiate Failover to Secondary",
        "type": "system",
        "action": "failover",
        "parameters": {
          "primaryUrl": "${primaryUrl}",
          "secondaryUrl": "${secondaryUrl}",
          "automatic": "false",
          "requireApproval": "true"
        },
        "runIf": "${canFailover}",
        "description": "Prepare failover to backup service"
      },
      {
        "id": "create-incident",
        "name": "Create Incident Ticket",
        "type": "integration",
        "action": "create-incident",
        "parameters": {
          "system": "PagerDuty",
          "severity": "high",
          "title": "Service Health Check Failed",
          "description": "Automated health monitoring detected service failure",
          "assignToOnCall": "true"
        }
      }
    ]
  },
  
  "cleanup": {
    "steps": [
      {
        "id": "cleanup-old-metrics",
        "name": "Clean Up Old Metrics Files",
        "type": "file",
        "action": "cleanup",
        "parameters": {
          "path": "metrics",
          "pattern": "health-*.json",
          "olderThanDays": "7"
        }
      }
    ]
  },
  
  "metadata": {
    "estimatedDuration": "00:00:30",
    "requiredPermissions": ["Network.Access", "FileSystem.Write"],
    "compatibility": ["Windows", "Linux", "macOS"],
    "category": "Monitoring",
    "complexity": "Medium",
    "dependencies": ["network-connectivity", "email-server"]
  }
}
